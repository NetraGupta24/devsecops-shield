# Template for jenkins/.env, which docker compose loads into the Grafana container.
#   cp .env.example .env    then fill in the values. NEVER commit .env (it is gitignored).

# Password for Grafana's "admin" user (applied when Grafana starts for the first time).
GF_SECURITY_ADMIN_PASSWORD=

# Access key of the READ-ONLY IAM user "splitease-grafana" (created by Terraform).
# Create it with:  aws iam create-access-key --user-name splitease-grafana
GRAFANA_AWS_ACCESS_KEY_ID=
GRAFANA_AWS_SECRET_ACCESS_KEY=
