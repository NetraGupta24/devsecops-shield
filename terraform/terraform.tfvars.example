# Copy this file to terraform.tfvars (which is gitignored) and fill in YOUR values.
#   cp terraform.tfvars.example terraform.tfvars

# Your current public IP + /32. Find it with: curl -s https://checkip.amazonaws.com
# (Home internet IPs can change; if SSH or port 8080 stops working, update this and re-apply.)
my_ip = "203.0.113.10/32"

# Where CloudWatch alarm emails go. Confirm the subscription email AWS sends you.
alert_email = "you@example.com"

# Optional overrides (defaults shown):
# instance_type             = "t3.micro"
# ssh_public_key_path       = "~/.ssh/splitease-deploy.pub"
# health_check_grace_period = 300
