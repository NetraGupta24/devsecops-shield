{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NetworkComputeLoadBalancingScalingMumbaiOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "elasticloadbalancing:*",
        "autoscaling:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "EcrSplitEaseRepositoryOnly",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": "arn:aws:ecr:ap-south-1:*:repository/splitease"
    },
    {
      "Sid": "IamSplitEaseRolesUsersProfilesOnly",
      "Effect": "Allow",
      "Action": "iam:*",
      "Resource": [
        "arn:aws:iam::*:role/splitease-*",
        "arn:aws:iam::*:user/splitease-*",
        "arn:aws:iam::*:instance-profile/splitease-*"
      ]
    },
    {
      "Sid": "ServiceLinkedRolesForElbAndAutoScaling",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "elasticloadbalancing.amazonaws.com",
            "autoscaling.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "SsmSplitEaseParametersOnly",
      "Effect": "Allow",
      "Action": "ssm:*",
      "Resource": "arn:aws:ssm:ap-south-1:*:parameter/splitease/*"
    },
    {
      "Sid": "LogsSplitEaseLogGroupsOnly",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "arn:aws:logs:ap-south-1:*:log-group:/splitease/*"
    },
    {
      "Sid": "AlarmsSplitEaseOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:SetAlarmState",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource"
      ],
      "Resource": "arn:aws:cloudwatch:ap-south-1:*:alarm:splitease-*"
    },
    {
      "Sid": "SnsSplitEaseTopicsOnly",
      "Effect": "Allow",
      "Action": "sns:*",
      "Resource": "arn:aws:sns:ap-south-1:*:splitease-*"
    }
  ]
}
