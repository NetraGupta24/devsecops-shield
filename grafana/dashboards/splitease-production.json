  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**SplitEase - Production** (CloudWatch, refreshes every minute). **Blue-Green:** the colour that receives requests is live; the other is idle and kept for rollback. **Vertical markers** are Jenkins annotations (release = traffic switched, rollback = traffic switched back). CPU above 50% makes Auto Scaling add an instance; above 70% for 3 min raises the CPU alarm."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU utilisation per Auto Scaling Group",
      "description": "Average CPU of each colour's ASG (1-minute detailed monitoring). Target tracking keeps it at 50%.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true,
            "lineInterpolation": "linear",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 70
              }
            ]
          },
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^blue.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^green.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transformations": [],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/EC2",
          "metricName": "CPUUtilization",
          "dimensions": {
            "AutoScalingGroupName": "splitease-blue"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true,
          "label": "blue",
          "id": "",
          "expression": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
